# Copia este archivo como ".env" y ajusta los valores.
# MongoDB local:
MONGO_URI=mongodb://127.0.0.1:27017/
# MongoDB Atlas (ejemplo):
# MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxx.mongodb.net/

# Sample oficial (solo lectura)
DB_SAMPLE=sample_mflix
COLL_SAMPLE=movies

# Colección de trabajo (carga masiva, CRUD y benchmarks; se puede borrar)
DB_WORK=proyecto2a
COLL_WORK=movies_carga

# Concurrencia y lotes de la app asíncrona
ASYNC_CONCURRENCY=10
BULK_BATCH_SIZE=1000
